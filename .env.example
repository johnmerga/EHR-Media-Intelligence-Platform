# Copy to .env and fill in. The pipeline and the app both run without any of these:
# committed summaries are served from the cache, and no key is needed to search.

# --- LLM used by `ehr summarize` (any OpenAI-compatible chat completions API) ---
EHR_LLM_API_KEY=

# OpenAI (default)
EHR_LLM_BASE_URL=https://api.openai.com/v1
EHR_LLM_MODEL=gpt-4o-mini

# Gemini, through its OpenAI-compatible endpoint
# EHR_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EHR_LLM_MODEL=gemini-3.5-flash-lite

# --- Web ---
# Host port the UI is published on by docker compose.
WEB_PORT=8080
